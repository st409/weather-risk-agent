# Used only to draft prose. Leave blank and the agent still answers from computed scores.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# live calls Open-Meteo and the National Weather Service.
# fixture uses the deterministic offline climatology (tests and evals).
WEATHER_DATA_MODE=live

# Optional override. Default is backend/data/weather_risk.db
# DATABASE_PATH=

# National Weather Service requires a User-Agent.
NWS_USER_AGENT=weather-risk-agent/0.1 (local demo)
ALERT_CACHE_MINUTES=30
