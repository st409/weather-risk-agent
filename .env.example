# Used only to draft prose. Leave blank and the agent still answers from computed scores.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# live calls Open-Meteo and the National Weather Service.
# fixture uses the deterministic offline climatology (tests and evals).
WEATHER_DATA_MODE=live

# Optional override. Default is backend/data/weather_risk.db
# DATABASE_PATH=

# Comma-separated browser origins allowed to call the API. Set this on Render
# to the Vercel URL, for example https://weather-risk-agent.vercel.app
# ALLOWED_ORIGINS=

# National Weather Service requires a User-Agent.
NWS_USER_AGENT=weather-risk-agent/0.1 (local demo)
ALERT_CACHE_MINUTES=30

# Secret for POST /api/admin/refresh-scores (send it as the X-Admin-Token header).
# Leave empty and that route returns 404.
ADMIN_TOKEN=

# Per-IP limit on POST /api/chat, requests per minute. 0 turns it off.
# CHAT_RATE_LIMIT_PER_MIN=30
